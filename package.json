{
  "name": "blog",
  "private": true,
  "type": "module",
  "description": "Mahmoud Zohdi's blog at blog.zohdi.me, built with Astro.",
  "scripts": {
    "dev": "astro dev",
    "dev:showcase": "BLOG_FIXTURES=1 astro dev",
    "check:content": "node scripts/check-content.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test": "vitest run",
    "build": "npm run check:content && astro check && vitest run && astro build && npm run check:dist",
    "build:test": "SHOW_DRAFTS=1 BLOG_FIXTURES=1 astro build --outDir dist-test",
    "preview": "astro preview",
    "preview:test": "astro preview --outDir dist-test",
    "test:e2e": "playwright test",
    "export": "node scripts/export.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/alexandria": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/transformers": "^4.5.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "astro": "^7.4.4",
    "satori": "^0.63.2",
    "shiki": "^4.5.0",
    "typescript": "^6.0.3",
    "ultrahtml": "^1.7.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0",
    "yaml": "^2.9.1"
  }
}
